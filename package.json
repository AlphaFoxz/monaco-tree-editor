{
  "name": "monaco-tree-editor",
  "version": "1.2.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "description": "the web editor with file tree based on 'monaco-editor'",
  "private": true,
  "keywords": [
    "moanco-editor",
    "vue-monaco-editor",
    "vue-monaco-tree",
    "web-editor"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "AlphaFoxz",
    "url": "https://github.com/AlphaFoxz"
  },
  "repository": "https://github.com/AlphaFoxz/monaco-tree-editor",
  "homepage": "https://alphafoxz.github.io/monaco-tree-editor/",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:compile && pnpm verify && pnpm build:sync-file",
    "build:compile": "vite build",
    "build:sync-file": "node ./script/build-sync-file.mjs",
    "verify": "vue-tsc -p tsconfig.app.json --composite false",
    "test:start-server": "node ./script/get-rand-test-port.mjs && vite -m test",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "nanoid": "^5.1.6",
    "ts-deferred": "^1.0.4",
    "vue-fn": "0.3.0-rc"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.52.2",
    "vue": ">=3.5.12"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.7",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "cypress": "^15.9.0",
    "cypress-real-events": "^1.15.0",
    "get-port": "^7.1.0",
    "jsdom": "^27.4.0",
    "monaco-editor": "^0.52.2",
    "ncp": "^2.0.0",
    "read-pkg": "^10.0.0",
    "sass": "^1.97.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.2"
  }
}
